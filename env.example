# ════════════════════════════════════════════════
#  VARIABLES DE ENTORNO — rellena todos los campos
# ════════════════════════════════════════════════

# ── Base de datos ────────────────────────────────
DB_ROOT_PASSWORD=
DB_PASSWORD=
DB_USER=
DB_NAME=

# ── Lector IA (Gemini Flash) ─────────────────────
CLAVE_1=
CLAVE_2=
CLAVE_3=
CLAVE_4=
CLAVE_5=

# ── Tailscale Funnel ─────────────────────────────
# 1. Crea una auth key en: https://login.tailscale.com/admin/settings/keys
#    Marca "Reusable" y "Ephemeral" si el host no es permanente.
# 2. Activa Funnel en tu cuenta: https://login.tailscale.com/admin/acls
#    Añade  "nodeAttrs": [{"target": ["*"], "attr": ["funnel"]}]
TAILSCALE_AUTHKEY=
TS_HOSTNAME=

CLOUDFLARE_TUNNEL_TOKEN=

# ── Entorno de la app ────────────────────────────
NODE_ENV=

#GRAFANA USER
GF_ADMIN_USER=
GF_ADMIN_PASSWORD=
METRICS_PORT=
#more grafana stuff
HOME=
XDG_RUNTIME_DIR=

# ── Open Products Facts ─────────────────────
OPF_USER_ID=
OPF_PASSWORD=
#OPENFACTS_API_KEY=

#para evitar fallos en cambios de ventana
SESSION_SECRET=
AES_SALT=

DB_USER_PROXY=
DB_PASSWORD_PROXY=

PROXYSQL_MONITOR_USER=
PROXYSQL_MONITOR_PASSWORD=

PROXYSQL_ADMIN_USER=
PROXYSQL_ADMIN_PASSWORD=
PROXYSQL_ADMIN_RO_USER=
PROXYSQL_ADMIN_RO_PASSWORD=