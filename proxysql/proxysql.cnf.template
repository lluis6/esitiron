datadir="/var/lib/proxysql"

admin_variables=
{
  admin_credentials="${PROXYSQL_ADMIN_USER}:${PROXYSQL_ADMIN_PASSWORD}"
  mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
  threads=4
  max_connections=2048
  default_query_timeout=36000000
  connect_timeout_server=1000
  monitor_username="${PROXYSQL_MONITOR_USER}"
  monitor_password="${PROXYSQL_MONITOR_PASSWORD}"
  monitor_connect_interval=2000
  monitor_read_only_interval=1500
  monitor_read_only_timeout=500
  monitor_replication_lag_interval=10000
  monitor_replication_lag_timeout=1000
  ping_interval_server_msec=120000
  ping_timeout_server=500
  commands_stats=true
  sessions_sort=true
}

mysql_servers =
(
  { address="db", port=3306, hostgroup=10, max_connections=1000 },
  { address="db_replica", port=3306, hostgroup=20, max_connections=1000 }
)

mysql_replication_hostgroups =
(
  { writer_hostgroup=10, reader_hostgroup=20, check_type="read_only", comment="esitiron-ha" }
)

mysql_users =
(
  { username="${DB_USER}", password="${DB_PASSWORD}", default_hostgroup=10, transaction_persistent=1, active=1 }
)
