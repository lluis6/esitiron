[mysqld]
server-id                = 2
log_bin                  = /var/log/mysql/mysql-bin.log
gtid_mode                = ON
enforce_gtid_consistency = ON
binlog_format            = ROW
# Protege al esclavo de escrituras accidentales
read_only                = 1 
# Permite que este esclavo se convierta en Master y tenga su propio binlog
log_slave_updates        = ON